{
  "info": {
    "name": "Restaurant API",
    "description": "Assignment 2 - Menu API requests (working and failing cases).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "menuItemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Menu - working requests",
      "item": [
        {
          "name": "GET health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET all menu items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Returns an array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET menu by category (Mains)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu?category=Mains",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Mains"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"All items are Mains\", function () { pm.response.json().forEach(function (i) { pm.expect(i.category).to.eql(\"Mains\"); }); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET search by name (chicken)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu?search=chicken",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "chicken"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST create menu item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Pizza\",\n  \"description\": \"Created from Postman\",\n  \"price\": 900,\n  \"category\": \"Mains\",\n  \"image\": \"\",\n  \"isSpecial\": false,\n  \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"menuItemId\", pm.response.json()._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET one menu item by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu/{{menuItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu",
                "{{menuItemId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT update price",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/menu/{{menuItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu",
                "{{menuItemId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Price updated\", function () { pm.expect(pm.response.json().price).to.eql(1100); });"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE menu item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu/{{menuItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu",
                "{{menuItemId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
